# ============================================================
# SWIPE CONFIG — C-Level Squad
# ============================================================
# Configuração para captura, organização e utilização de swipe files.
# Swipe files são exemplos curados de excelência que servem como
# referência e inspiração para os agentes do C-Level Squad.
# ============================================================

swipe:
  version: "1.0.0"
  description: "Configuração de swipe files para o C-Level Squad"

# ============================================================
# DIRETÓRIOS DE SWIPE
# ============================================================
directories:
  swipe_root: "swipe/"
  sources_root: "swipe-sources/"

  categories:
    - name: strategy-decks
      path: "swipe/strategy-decks/"
      description: "Decks de estratégia de referência"
      tags: [strategy, vision, planning]
      agents: [vision-chief, coo-orchestrator]

    - name: decision-memos
      path: "swipe/decision-memos/"
      description: "Memos de decisão icônicos e exemplares"
      tags: [decision, memo, leadership]
      agents: [vision-chief, coo-orchestrator]

    - name: operating-reviews
      path: "swipe/operating-reviews/"
      description: "Exemplos de WBR/MBR/QBR bem executados"
      tags: [operations, review, cadence]
      agents: [coo-orchestrator]

    - name: org-design
      path: "swipe/org-design/"
      description: "Modelos organizacionais de referência"
      tags: [org-design, structure, teams]
      agents: [coo-orchestrator, vision-chief]

    - name: hiring
      path: "swipe/hiring/"
      description: "Scorecards e frameworks de entrevista"
      tags: [hiring, talent, leadership]
      agents: [vision-chief, coo-orchestrator]

    - name: crisis-comms
      path: "swipe/crisis-comms/"
      description: "Comunicações de crise exemplares"
      tags: [crisis, communication, leadership]
      agents: [vision-chief, coo-orchestrator]

    - name: ai-use-cases
      path: "swipe/ai-use-cases/"
      description: "Cases de IA em negócio"
      tags: [ai, use-case, roi]
      agents: [caio-architect, cto-architect]

    - name: tech-architecture
      path: "swipe/tech-architecture/"
      description: "ADRs e docs de arquitetura exemplares"
      tags: [architecture, engineering, adr]
      agents: [cto-architect, cio-engineer]

# ============================================================
# FONTES CURADAS
# ============================================================
sources:
  - name: first-round-review
    url: "https://review.firstround.com/"
    focus: "Startups, liderança, operações, growth"
    cadence: weekly
    index_file: "swipe-sources/first-round-review-index.md"

  - name: lenny-newsletter
    url: "https://www.lennysnewsletter.com/"
    focus: "Produto, growth, métricas, benchmarks"
    cadence: weekly
    index_file: "swipe-sources/lenny-newsletter-index.md"

  - name: stratechery
    url: "https://stratechery.com/"
    focus: "Estratégia de tecnologia, modelos de negócio"
    cadence: weekly
    index_file: "swipe-sources/stratechery-index.md"

  - name: reforge
    url: "https://www.reforge.com/"
    focus: "Growth, retention, engagement, monetization"
    cadence: monthly
    index_file: "swipe-sources/reforge-index.md"

  - name: pragmatic-engineer
    url: "https://newsletter.pragmaticengineer.com/"
    focus: "Engenharia, plataforma, cultura tech"
    cadence: weekly
    index_file: "swipe-sources/pragmatic-engineer-index.md"

  - name: ai-research
    focus: "IA: Anthropic, OpenAI, DeepMind, Google AI"
    cadence: weekly
    index_file: "swipe-sources/ai-research-index.md"

# ============================================================
# REGRAS DE CAPTURA
# ============================================================
capture:
  protocol_file: "swipe-sources/capture-protocol.md"

  rules:
    - rule: "Todo swipe deve ter fonte, data e contexto"
      enforcement: "Cabeçalho obrigatório com metadata"

    - rule: "Swipe não é cópia — é análise + adaptação"
      enforcement: "Seção obrigatória: 'O que aprendemos' + 'Como aplicar'"

    - rule: "Swipe deve estar vinculado a pelo menos 1 agente"
      enforcement: "Tag de agente obrigatória no cabeçalho"

    - rule: "Atualizar sources-list.md mensalmente"
      enforcement: "Task mensal em tasks/operations/"

  metadata_template: |
    ---
    source: [nome da fonte]
    url: [URL original]
    date_captured: [YYYY-MM-DD]
    category: [strategy-decks|decision-memos|operating-reviews|org-design|hiring|crisis-comms|ai-use-cases|tech-architecture]
    agents: [lista de agentes relevantes]
    tags: [tags descritivas]
    quality: [gold|silver|bronze]
    ---
